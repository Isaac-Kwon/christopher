	(text "Diagonal board D4 of 5 - letters J W K X (4 letters, 8 jacks).\nLink net L_XY joins wire Y of letter X and wire X of letter Y on all four jacks of the two letters; S_X = own wire of letter X.\nJunction headers: 3 per boundary, ribbon pin n <-> pin n; links sorted by (X,Y) take connector (i // 64 + 1), pin i % 64 + 1.\nConnector 3 pins 61-64 = 0 V reference (GND), tied to every jack pins 27-29 and to the single power-0V terminal J0V (D1).\nShells and mounting holes = CHASSIS; CHASSIS - 0 V by 1 Mohm || 10 nF (R1, C1)."
		(exclude_from_sim no)
		(at 40 30 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "1bf94a88-c671-544e-a9ac-bceab5c7b5ee")
	)
	(embedded_fonts no)
)
