	(text "Diagonal board D1 of 5 - letters A N B O C P (6 letters, 12 jacks).\nLink net L_XY joins wire Y of letter X and wire X of letter Y on all four jacks of the two letters; S_X = own wire of letter X.\nJunction headers: 3 per boundary, ribbon pin n <-> pin n; links sorted by (X,Y) take connector (i // 64 + 1), pin i % 64 + 1.\nConnector 3 pins 61-64 = 0 V reference (GND), tied to every jack pins 27-29 and to the single power-0V terminal J0V (D1).\nShells and mounting holes = CHASSIS; CHASSIS - 0 V by 1 Mohm || 10 nF (R1, C1)."
		(exclude_from_sim no)
		(at 40 30 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "3441e516-cb88-5f63-aec6-89b77da57686")
	)
	(embedded_fonts no)
