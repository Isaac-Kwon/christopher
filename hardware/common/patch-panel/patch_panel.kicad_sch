	(text "Menu patch panel board (common part).  Commons: four groups of four jacks, 26 lines parallel within a group.\nRegister: JR1 (front) / JR2 (rear) parallel.  Searching: JS1 line k -> TS1 hole k; plug PL1 (TEST) into hole k puts the\ntest voltage on wire k of the cable on JS1 (the wire the menu uses as input wire).  Pins 27-29 of all jacks = GND (tied here)."
		(exclude_from_sim no)
		(at 40 20 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "fd989746-1d64-5db9-a660-bd3473966d18")
	)
	(embedded_fonts no)
