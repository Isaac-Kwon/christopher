	(title_block
		(title "Power and protection (24 V field supply, 5 V field rail)")
		(date "2026-11-15")
		(rev "A")
		(comment 1 "24 V SELV adapter -> PTC 0.5 A -> field 24 V; separate PTC 2 A + jumper for the J_C bank supply (default open)")
		(comment 2 "TSR 1-2450 (24 V -> 5 V, 1 A) supplies 74HC595, TBD62783A inputs and the field side of the isolators")
		(comment 3 "The 24 V adapter is floating w.r.t. USB: GND_F is the field ground, GND_M the USB/MCU ground")
	)
