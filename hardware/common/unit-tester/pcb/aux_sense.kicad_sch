	(title_block
		(title "Auxiliary sense inputs (J_C): POS, flags, ESTOP/ILOCK, JUDGE, CLEAR, STOP_LATCH")
		(date "2026-11-15")
		(rev "A")
		(comment 1 "Bits 52-66 POS0-14, 67 STOPPED, 68 AT_HOME, 69 END, 70 ESTOP_OK, 71 ILOCK_OK (HAL flag bits), 72 JUDGE, 73 CLEAR, 74 STOP_LATCH")
		(comment 2 "ESTOP / ILOCK (0003 4.6): the BANK feeds J_C 22 / 24; the tester returns the loop (JP2 / JP3, bridged) to 23 / 25 and senses 23 / 25 through 2.2k; closed and fed reads 1")
		(comment 3 "JP4 / JP5 (default open) feed the loops from +24V_F through 2.2k for a bench target without power. Opto unit 76 of U68 (bit 75) is spare")
	)
