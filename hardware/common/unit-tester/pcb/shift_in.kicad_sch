	(paper "A1")
	(title_block
		(title "Input shift registers: 10 x 74HC165 (80 bits)")
		(date "2026-11-15")
		(rev "A")
		(comment 1 "Chain: DS of U30 (bits 0-7) = GND; Q7 of chip c -> DS of chip c+1; Q7 of U39 (bits 72-79) -> MISO_165")
		(comment 2 "First bit shifted out = bit 79 (HAL: first byte = most significant)")
		(comment 3 "Bit n: chip U30+n//8, input D(n%8); bits 0-51 nodes, 52-66 POS, 67-71 flags, 72 JUDGE, 73 CLEAR, 74 STOP_LATCH, 75-79 tied low")
	)
