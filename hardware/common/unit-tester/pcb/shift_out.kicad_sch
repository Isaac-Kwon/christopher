	(paper "A1")
	(title_block
		(title "Output shift registers: 7 x 74HC595 (56 bits)")
		(date "2026-11-15")
		(rev "A")
		(comment 1 "Chain: MOSI_F -> U10 (bits 0-7) -> U11 (8-15) ... -> U16 (48-55); HAL sends 7 bytes MSB first")
		(comment 2 "Bit n is on chip U10+n//8, output Q(A + n%8); DRV_IN_n goes to the TBD62783A input of node n")
		(comment 3 "Bits 54, 55 unused (RUN/HOME drivers take RUN_F/HOME_F directly); bits 52, 53 spare")
	)
