	(paper "A1")
	(title_block
		(title "Sense lanes K1..K26 (self-holding sense relay + blocking diode + lamp driver)")
		(date "2026-11-15")
		(rev "A")
		(comment 1 "26 identical lanes. Lane i: line L_i -> blocking diode -> node N_i -> coil K_i (+ flyback diode).")
		(comment 2 "K_i pole 1 = hold contact (H -> N_i). Pole 2 = chain contact (series chain H ... PN -> pass relay P).")
		(comment 3 "Lamp driver: N_i -> divider -> MOSFET Q_i; drain LAMP_i sinks the display slave relay; source LAMPGND = switched by S.")
	)
