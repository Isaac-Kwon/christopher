	)
	(text "ROTOR SOCKET (one per unit).  The bay + the cartridge in it = one W card of the card arrangement:\n  outbound: lead into J(4b+3) pin i+1 -> pin <b>OI(i+1) -> cartridge -> pin <b>OO(W[i]+1) -> J(4b+1) -> lead\n  return:   lead into J(4b+4) pin j+1 -> pin <b>RI(j+1) -> cartridge -> pin <b>RO(Winv[j]+1) -> J(4b+2) -> lead\nDetect chain in series with the lid switches: open whenever a bay is empty, a cartridge is not seated or a lid is open.\nNo 0 V and no supply on this board; the chain is the ILOCK loop of the bank (power-unit.md)."
		(exclude_from_sim no)
		(at 40 330 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left top)
		)
		(uuid "b4fc7a2c-e47d-56e6-bf8b-8a4163ebc97b")
	)
	(embedded_fonts no)
