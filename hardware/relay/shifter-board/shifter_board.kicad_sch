	(text "Relay shifter board - one shifter pair (outbound + return halves share the coils)\nConnectors: J1 outbound IN, J2 return IN (one board edge); J3 outbound OUT, J4 return OUT (opposite edge); J5 control.\nD-sub 37: pins 1-26 = lines A-Z (as unit tester J_A/J_B), 27-29 = 0 V reference, NOT connected here, 30-37 reserved.\nJ5 D-sub 9: 1-5 = CTRL0-4 (24 V, weights 1,2,4,8,16), 6-7 = 0 V.\nReverse mounting swaps IN/OUT on both halves: outbound -> i-a, return -> i+a."
		(exclude_from_sim no)
		(at 40 30 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "31f57f5f-0bf8-5600-9cab-680c9aa858d0")
	)
	(embedded_fonts no)
)
