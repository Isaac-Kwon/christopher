	(text "CHASSIS (decision 0003 7.1): D-sub shells J1-J5 (footprint pads SH) and mounting holes H1-H4 = CHASSIS, not 0 V.\nR6 1 Mohm || C1 10 nF/100 V between CHASSIS and 0 V (electrostatic path, open for DC).\nJ1-J4 pins 27-29 are not connected here (0003 5.2: the 0 V reference is tied on the common side only).\n0 V returns through J5 pins 6-7 only. No fuse on this board: it has no power input, CTRL lines are fused on the counter unit board (0003 6, 7.3)."
		(exclude_from_sim no)
		(at 300 500 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "fdcb183c-abf3-50fd-a195-5a65cd023bb4")
	)
