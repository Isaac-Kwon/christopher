	(text "Relay shifter board - one shifter pair (outbound + return halves share the coils)\nConnectors: J1 outbound IN, J2 return IN (one board edge); J3 outbound OUT, J4 return OUT (opposite edge); J5 control.\nD-sub 37: pins 1-26 = lines A-Z (as unit tester J_A/J_B), 27-29 = 0 V, 30-37 reserved.\nJ5 D-sub 9: 1-5 = CTRL0-4 (24 V, weights 1,2,4,8,16), 6-7 = 0 V.\nReverse mounting swaps IN/OUT on both halves: outbound -> i-a, return -> i+a."
		(exclude_from_sim no)
		(at 40 30 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "44b2c583-258c-51f4-96a9-575d2842746c")
	)
	(embedded_fonts no)
)
