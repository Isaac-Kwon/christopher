	(text "Digit l (left rotor = fast): contact tree rooted at bit 0.  Level b has its COM on node LN<b>_<p> (p = value of bits 0..b-1; level 0 = +24V);\nNC -> prefix p, NO -> prefix p + 2^b.  Bit 4 has contacts only for p = 0..9 (16 + p <= 25); nodes LN4_10..15 are the lamps 10..15 directly.\nExactly one leaf LLAMPvv is at +24 V for every code 0..25 -> lamp vv (letter A + vv).  Codes 26..31 never occur (counter 0..25)."
		(exclude_from_sim no)
		(at 20 14 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "68d4b74e-4d76-59b2-a189-1ffc9c6a33a9")
	)
