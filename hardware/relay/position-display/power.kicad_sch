	(text "J1 POS_IN = counter common J4 (same pins; a third IDC socket on the POS ribbon).  J2 = +24V_L from power unit F12.\nPower input chain (decision 0003 7.3): PTC 0.5 A -> series P-MOSFET Q1 (drain on the supply side) + DZ1/RG1 -> TVS1, CB1.\nCHASSIS (0003 7.1): H1-H4 + D-sub shell = CHASSIS, RCH1 1M || CCH1 10nF to 0 V."
		(exclude_from_sim no)
		(at 20 14 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "96200154-ae89-5dd6-81ed-367bc3f50e33")
