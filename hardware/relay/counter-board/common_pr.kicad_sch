	(text "Row 1: slave relays KS (K400..K404) and wrap relay KW (K420). Row 2: master relays KM (K410..K414).\nUnder each column: slave feed diodes (hold / load / preset), master feed diodes (mirror / hold),\ncoil flyback diodes. Rails Z1..ZOUT: diode OR of ZIN and Y_j (j below the bit)."
		(exclude_from_sim no)
		(at 20 14 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "f116ad20-4d97-595d-aeb6-e60d37bf8059")
	)
	(text "Rail Z_i = NOT A_i.  A_{i+1} = A_i AND (master_i = 0) (NC contact chain, master = NOT slave = 'bit is 1').\nSlave i toggles (loads the master) only when A_i is up; otherwise rail Z_i holds it and keeps the mirror running."
		(exclude_from_sim no)
		(at 20 410 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "2fe35a74-6011-510e-954c-c03c93c55734")
	)
