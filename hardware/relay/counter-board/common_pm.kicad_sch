	(text "Clock bus B (units 7-12): twin masters K230..K234 repeat the carry chain\nfrom AIN_B; ZOUT_B = ZIN_B OR YB_j, NOUT_B = OR of YB_j."
		(exclude_from_sim no)
		(at 455 66 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "940d2780-fa71-544e-ae55-7cd2fcf27758")
	)
	(text "Row 1: slave relays KS (K200..K204) and wrap relay KW (K220). Row 2: master relays KM (K210..K214).\nUnder each column: slave feed diodes (hold / load / preset), master feed diodes (mirror / hold),\ncoil flyback diodes. Rails Z1..ZOUT: diode OR of ZIN and Y_j (j below the bit)."
		(exclude_from_sim no)
		(at 20 14 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "4250ac37-b8c0-5809-8a4b-0104bd968bbd")
	)
	(text "Rail Z_i = NOT A_i.  A_{i+1} = A_i AND (master_i = 0) (NC contact chain, master = NOT slave = 'bit is 1').\nSlave i toggles (loads the master) only when A_i is up; otherwise rail Z_i holds it and keeps the mirror running."
		(exclude_from_sim no)
		(at 20 410 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "eaba7402-7a36-544e-a4f6-9d7102576f28")
	)
