	(text "Row 1: slave relays KS (K100..K104) and wrap relay KW (K120). Row 2: master relays KM (K110..K114).\nUnder each column: slave feed diodes (hold / load / preset), master feed diodes (mirror / hold),\ncoil flyback diodes. Rails Z1..ZOUT: diode OR of ZIN and Y_j (j below the bit)."
		(exclude_from_sim no)
		(at 20 14 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "aee8065a-faf1-5d36-8d6f-475aad82810a")
	)
	(text "Rail Z_i = NOT A_i.  A_{i+1} = A_i AND (master_i = 0) (NC contact chain, master = NOT slave = 'bit is 1').\nSlave i toggles (loads the master) only when A_i is up; otherwise rail Z_i holds it and keeps the mirror running."
		(exclude_from_sim no)
		(at 20 410 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "89ea3168-f3d5-50e0-a3b2-ce2d44df0526")
	)
