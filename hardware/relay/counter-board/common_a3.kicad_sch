	(text "Row 1: slave relays KS (K300..K304) and wrap relay KW (K320). Row 2: master relays KM (K310..K314).\nUnder each column: slave feed diodes (hold / load / preset), master feed diodes (mirror / hold),\ncoil flyback diodes. Rails Z1..ZOUT: diode OR of ZIN and Y_j (j below the bit)."
		(exclude_from_sim no)
		(at 20 14 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "e2f9ef57-af0e-5c89-a341-ef934aaaca75")
	)
	(text "Rail Z_i = NOT A_i.  A_{i+1} = A_i AND (master_i = 0) (NC contact chain, master = NOT slave = 'bit is 1').\nSlave i toggles (loads the master) only when A_i is up; otherwise rail Z_i holds it and keeps the mirror running."
		(exclude_from_sim no)
		(at 20 410 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "ab2cdd10-f16b-5521-98f3-09f3182f113a")
	)
