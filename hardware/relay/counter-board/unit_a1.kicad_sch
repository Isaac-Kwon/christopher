	(title_block
		(title "Base-26 relay digit a1 = r + k")
		(date "2026-11-15")
		(rev "A")
		(comment 1 "a1 = r + k: 5 slave relays KS (state, drive CTRL), 5 master relays KM, 1 wrap relay KW")
		(comment 2 "AIN/ZIN = advance / hold rail pair (complementary); AOUT/ZOUT = carry (25 -> 0) rail pair")
		(comment 3 "Q0..Q4 = 24 V when the bit is 1 (binary 0..25); P0..P4 = preset code (24 V only while LOAD)")
		(comment 4 "Generated by gen_counter.py - do not edit by hand")
	)
