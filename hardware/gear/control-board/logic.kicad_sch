(kicad_sch
	(version 20250610)
	(generator "eeschema")
	(generator_version "10.0")
	(uuid "94a8f9ab-5bc0-53a5-84c0-49a385346e7e")
	(paper "A1")
	(title_block
		(title "Timing gating (hardware, no firmware): STROBE_G / JUDGE_G / CLEAR_G, cycle hold CYC, SEEN (L8)")
		(date "2026-11-15")
		(rev "A")
		(comment 1 "STROBE_G = SLOT_S & TXE ; CLEAR_G = SLOT_C & TXE ; JUDGE_G = SLOT_J & SEEN & TXE ; TXE = TXEN | CYC (74HC32)")
		(comment 2 "CYC (74HC74 unit 2): set while STROBE_G is high, cleared by the falling edge of CLEAR_G -> a started cycle is always finished (L7)")
		(comment 3 "SEEN (74HC74 unit 1): set by the rising edge of STROBE_G, cleared by POR | HOMING | falling edge of STOP_LATCH (RC pulse) -> no JUDGE before a STROBE (L8)")
	)
