	(text "CYC ~S = STROBE_N (low while STROBE_G high), ~R = POR_RC, D = 0, clock = CLRN (rises when CLEAR_G falls).\nSEEN D = 1, clock = STROBE_G, ~R = SEEN_R_N = NOR(POR | HOMING, SL_PULSE); SL_PULSE = SL_N & SL_DB (STOP_LATCH falling edge, about 0.5 ms).\nTP header (CONNECTORS sheet): SLOT_S SLOT_J SLOT_C = conditioned slot levels for the oscilloscope."
		(exclude_from_sim no)
		(at 40 520 0)
		(effects
