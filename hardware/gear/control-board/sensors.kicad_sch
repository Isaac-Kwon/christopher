(kicad_sch
	(version 20250610)
	(generator "eeschema")
	(generator_version "10.0")
	(uuid "2c0dfa1f-2171-5bb1-844c-0eecf785b54b")
	(paper "A1")
	(title_block
		(title "Photointerrupter inputs: 3 slot sensors + 6 position sensors, RC filter + 74HC14 Schmitt")
		(date "2026-11-15")
		(rev "A")
		(comment 1 "Sensor: 24 V photointerrupter, light-ON = open-collector output conducts (low). Connector JST-XH 3 pin: 1 = +24V_S (PTC F3), 2 = OUT, 3 = 0 V")
		(comment 2 "OUT -> 4.7k pull-up to +3V3 (the open collector only sees 3.3 V) -> 1k + 4.7n (about 5 us) -> 74HC14 (LOGIC sheet): inverted output = HIGH while the slot passes light")
		(comment 3 "The three slot outputs go to the gating (LOGIC sheet) and to the Pico (monitor); T/I outputs go to the Pico only")
	)
