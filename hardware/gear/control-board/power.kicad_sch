	(title_block
		(title "Power: +24V_L (always on), +24V_SW (cut by the emergency stop), 5 V / 3.3 V logic")
		(date "2026-11-15")
		(rev "A")
		(comment 1 "Two 24 V inputs, each: terminal -> PTC -> series P-MOSFET (reverse polarity) -> TVS 33 V + bulk C (decision 0003 7.3)")
		(comment 2 "+24V_L (power unit F16): logic, sensors, status/POS outputs.  +24V_SW (F21): STROBE/JUDGE/CLEAR, PUL/DIR/ENA drivers (cut by K_E)")
		(comment 3 "TSR 1-2450 5 V from +24V_L -> Pico VSYS (Schottky); Pico 3V3 supplies every 74HC gate and the optocoupler outputs")
	)
